        </div>
        <div class="now-actions">
          <button class="icon-btn" id="fullscreen" title="Toàn màn hình">⛶</button>
          <button class="icon-btn" id="copy" title="Sao chép link">↗</button>
        </div>
      </div>
    </section>

    <section class="content">
      <div class="section-head">
        <div><h2>📺 Kênh truyền hình</h2><div class="sub" id="count">0 kênh</div></div>
      </div>
      <div class="controls">
        <select id="groupSelect" aria-label="Nhóm kênh"><option value="">Tất cả nhóm</option></select>
        <button class="sort-btn active" data-sort="default">Mặc định</button>
        <button class="sort-btn" data-sort="az">A → Z</button>
        <button class="sort-btn" data-sort="favorites">★ Yêu thích</button>
      </div>
      <div class="groups" id="chips"></div>
      <div class="grid" id="list"></div>
    </section>
  </main>

  <aside class="sidebar">
    <div class="side-title"><strong>Nhóm kênh</strong><span class="count" id="groupCount"></span></div>
    <div id="sideGroups"></div>
  </aside>
</div>
<div class="footer">Myyer TV • Playlist được ghép từ SmolTelevision StaffOnly • Giao diện single-file HTML</div>
