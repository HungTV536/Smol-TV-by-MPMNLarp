<style>
:root{
  --bg:#07090e;--panel:#10131a;--panel2:#151923;--card:#181d27;--card2:#202633;
  --line:#2a3140;--text:#f5f7fb;--muted:#8d96a8;--accent:#8b7cff;--accent2:#5d7cff;
  --good:#45d483;--danger:#ff667d;--shadow:0 18px 60px rgba(0,0,0,.38);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:
  radial-gradient(circle at 12% -10%,rgba(139,124,255,.16),transparent 30%),
  radial-gradient(circle at 88% 0%,rgba(74,132,255,.10),transparent 25%),var(--bg);
  color:var(--text);font-family:"Myriad Pro","Gotham",Inter,Segoe UI,Arial,sans-serif;
}
button,input,select{font:inherit}
button{color:inherit}
.topbar{
  position:sticky;top:0;z-index:50;backdrop-filter:blur(20px);
  background:rgba(7,9,14,.82);border-bottom:1px solid rgba(255,255,255,.07);
}
.nav{
  max-width:1700px;margin:auto;padding:15px 22px;display:flex;gap:18px;align-items:center;
}
.brand{display:flex;align-items:center;gap:11px;min-width:max-content}
.brand-mark{
  width:40px;height:40px;border-radius:12px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--accent),var(--accent2));box-shadow:0 8px 24px rgba(110,102,255,.35);
  font-size:21px
}
.brand strong{font-size:19px;letter-spacing:-.4px}.brand small{display:block;color:var(--muted);font-size:10px;margin-top:1px;letter-spacing:1.2px;text-transform:uppercase}
.search-wrap{flex:1;position:relative;max-width:700px;margin-left:auto}
.search-wrap span{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#8f98aa}
#search{
  width:100%;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.08);
  border-radius:13px;color:var(--text);outline:none;padding:12px 44px 12px 40px;
  transition:.2s
}
#search:focus{border-color:rgba(139,124,255,.7);box-shadow:0 0 0 4px rgba(139,124,255,.10)}
.kbd{position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:10px;color:#8992a4;border:1px solid #343b49;border-radius:5px;padding:2px 5px}
.layout{max-width:1700px;margin:auto;padding:22px;display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:22px}
.main{min-width:0}
.hero{
  border:1px solid rgba(255,255,255,.08);border-radius:20px;overflow:hidden;background:#000;
  box-shadow:var(--shadow)
}
.video-shell{position:relative;background:#000;aspect-ratio:16/9}
video{width:100%;height:100%;display:block;background:#000;object-fit:contain}
.video-overlay{
  position:absolute;inset:0;pointer-events:none;display:flex;align-items:flex-start;justify-content:space-between;
  padding:14px
}
.live-pill,.quality-pill{
  padding:7px 10px;border-radius:999px;background:rgba(8,10,14,.72);border:1px solid rgba(255,255,255,.10);
  backdrop-filter:blur(10px);font-size:11px;font-weight:700
}
.live-pill{color:#fff}.live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#ff536d;box-shadow:0 0 10px #ff536d;margin-right:6px}
.nowbar{padding:18px 20px;background:linear-gradient(180deg,#12161e,#0e1117);display:flex;align-items:center;justify-content:space-between;gap:16px}
.now-main{min-width:0}.eyebrow{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);font-weight:800;margin-bottom:4px}
#current{font-size:21px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#status{font-size:12px;color:var(--muted);margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.now-actions{display:flex;gap:8px}
.icon-btn{
  border:1px solid #303746;background:#1b202b;border-radius:10px;width:40px;height:40px;cursor:pointer;
  display:grid;place-items:center;transition:.18s
}
.icon-btn:hover{background:#252c39;transform:translateY(-1px)}
.content{margin-top:22px}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:15px;margin:0 0 12px}
.section-head h2{margin:0;font-size:18px}.sub{font-size:12px;color:var(--muted)}
.controls{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
select,.sort-btn{
  background:#121720;border:1px solid #2a3140;border-radius:10px;padding:9px 12px;color:#dce1ea;outline:none;cursor:pointer
}
.sort-btn.active{border-color:rgba(139,124,255,.7);background:rgba(139,124,255,.12)}
.groups{display:flex;gap:7px;overflow:auto;padding-bottom:4px;scrollbar-width:thin}
.chip{border:1px solid #29303d;background:#11151d;color:#aeb6c6;border-radius:999px;padding:7px 11px;cursor:pointer;white-space:nowrap;font-size:12px}
.chip:hover{background:#1b202a;color:#fff}.chip.active{background:linear-gradient(135deg,rgba(139,124,255,.24),rgba(93,124,255,.16));color:#fff;border-color:rgba(139,124,255,.55)}
.grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px
}
.channel{
  position:relative;width:100%;min-height:86px;padding:12px;display:flex;align-items:center;gap:12px;
  background:linear-gradient(145deg,#171c25,#131720);border:1px solid #252c39;border-radius:14px;
  cursor:pointer;text-align:left;transition:transform .16s,border-color .16s,background .16s,box-shadow .16s
}
.channel:hover{transform:translateY(-2px);border-color:#424b5e;background:#1b212c;box-shadow:0 9px 24px rgba(0,0,0,.22)}
.channel.active{border-color:rgba(139,124,255,.85);box-shadow:0 0 0 1px rgba(139,124,255,.25),0 10px 30px rgba(91,80,210,.12)}
.logo{
  width:54px;height:54px;flex:0 0 54px;border-radius:11px;object-fit:contain;background:#0b0e13;
  border:1px solid #2b3240;padding:6px
}
.channel-info{min-width:0}.channel-name{font-weight:750;font-size:13px;line-height:1.25;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.channel-group{font-size:10px;color:#7f899c;margin-top:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.star{position:absolute;right:9px;top:7px;border:0;background:none;color:#667083;cursor:pointer;font-size:13px;padding:2px}
.star.on{color:#ffd65a}
.sidebar{
  position:sticky;top:88px;height:calc(100vh - 110px);min-height:520px;background:rgba(16,19,26,.86);
  border:1px solid rgba(255,255,255,.07);border-radius:18px;padding:16px;overflow:auto
}
.side-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:13px}
.side-title strong{font-size:14px}.count{color:var(--muted);font-size:11px}
.side-item{
  width:100%;display:flex;justify-content:space-between;align-items:center;background:transparent;border:1px solid transparent;
  color:#b7bfce;border-radius:10px;padding:10px 11px;cursor:pointer;text-align:left;margin-bottom:4px
}
.side-item:hover{background:#171c25;color:#fff}.side-item.active{background:rgba(139,124,255,.12);border-color:rgba(139,124,255,.22);color:#fff}
.side-item span:last-child{font-size:10px;color:#697386}
.empty{grid-column:1/-1;text-align:center;padding:45px 20px;color:#7f899c}
.empty b{display:block;color:#dce1ea;margin-bottom:5px}
.footer{max-width:1700px;margin:auto;padding:0 22px 30px;color:#626c7e;font-size:11px}
.toast{
  position:fixed;left:50%;bottom:25px;transform:translate(-50%,20px);opacity:0;pointer-events:none;
  background:#1a202b;border:1px solid #343c4b;border-radius:10px;padding:10px 14px;font-size:12px;transition:.22s;z-index:100
}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:1050px){.layout{grid-template-columns:1fr}.sidebar{position:static;height:auto;min-height:0;max-height:330px}.nav{padding:12px 15px}.layout{padding:15px}}
@media(max-width:650px){
  .brand small{display:none}.brand strong{font-size:16px}.nav{gap:10px}.kbd{display:none}
  .layout{padding:10px}.hero{border-radius:14px}.nowbar{padding:14px}.now-actions{display:none}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.channel{min-height:75px;padding:9px;gap:8px}.logo{width:43px;height:43px;flex-basis:43px}
  .channel-name{font-size:12px}.sidebar{border-radius:14px}
}
</style>
</head>
<body>
<header class="topbar">
  <nav class="nav">
    <div class="brand">
      <div class="brand-mark">▶</div>
      <div><strong>Myyer TV</strong><small>Live Television</small></div>
    </div>
    <div class="search-wrap">
      <span>⌕</span><input id="search" autocomplete="off" placeholder="Tìm kênh, đài truyền hình..." aria-label="Tìm kênh">
      <div class="kbd">Ctrl K</div>
    </div>
  </nav>
</header>

<div class="layout">
  <main class="main">
    <section class="hero">
      <div class="video-shell">
        <video id="video" controls playsinline></video>
        <div class="video-overlay">
          <div class="live-pill"><i class="live-dot"></i>LIVE</div>
          <div class="quality-pill">HLS</div>
        </div>
      </div>
      <div class="nowbar">
        <div class="now-main">
          <div class="eyebrow">Đang phát</div>
          <div id="current">Chưa chọn kênh</div>
