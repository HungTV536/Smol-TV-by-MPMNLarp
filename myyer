const video = document.getElementById('video');
const current = document.getElementById('current');
const status = document.getElementById('status');
const search = document.getElementById('search');
const list = document.getElementById('list');
const groupSelect = document.getElementById('groupSelect');
const chips = document.getElementById('chips');
const sideGroups = document.getElementById('sideGroups');
const count = document.getElementById('count');
const groupCount = document.getElementById('groupCount');
const toast = document.getElementById('toast');
let hls = null, active = null, group = '', sort = 'default';
let favorites = JSON.parse(localStorage.getItem('myyer-favorites') || '[]');

const groups = [...new Set(channels.map(c=>c.group || 'Khác'))];
groupCount.textContent = groups.length + ' nhóm';

function escapeHtml(s=''){
  return s.replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
}
function isFav(c){ return favorites.includes(c.name+'|'+c.url); }
function saveFav(){ localStorage.setItem('myyer-favorites', JSON.stringify(favorites)); }

function setGroup(g){
  group=g; groupSelect.value=g;
  document.querySelectorAll('.chip').forEach(x=>x.classList.toggle('active',x.dataset.group===g));
  document.querySelectorAll('.side-item').forEach(x=>x.classList.toggle('active',x.dataset.group===g));
  render();
}
function makeGroups(){
  groupSelect.innerHTML='<option value="">Tất cả nhóm</option>';
  groups.forEach(g=>{
    const o=document.createElement('option');o.value=g;o.textContent=g;groupSelect.appendChild(o);
  });
  chips.innerHTML='<button class="chip active" data-group="">Tất cả</button>'+groups.map(g=>`<button class="chip" data-group="${escapeHtml(g)}">${escapeHtml(g)}</button>`).join('');
  chips.querySelectorAll('.chip').forEach(b=>b.onclick=()=>setGroup(b.dataset.group));
  sideGroups.innerHTML='<button class="side-item active" data-group=""><span>🌐 Tất cả kênh</span><span>'+channels.length+'</span></button>'+
    groups.map(g=>`<button class="side-item" data-group="${escapeHtml(g)}"><span>${escapeHtml(g)}</span><span>${channels.filter(c=>c.group===g).length}</span></button>`).join('');
  sideGroups.querySelectorAll('.side-item').forEach(b=>b.onclick=()=>setGroup(b.dataset.group));
}
function filtered(){
  const q=search.value.trim().toLowerCase();
  let arr=channels.filter(c=>
    (!group || c.group===group) &&
    (!q || c.name.toLowerCase().includes(q) || (c.group||'').toLowerCase().includes(q))
  );
  if(sort==='favorites') arr=arr.filter(isFav);
  if(sort==='az') arr=[...arr].sort((a,b)=>a.name.localeCompare(b.name,'vi'));
  return arr;
}
function render(){
  const arr=filtered();
  count.textContent=`${arr.length.toLocaleString('vi-VN')} / ${channels.length.toLocaleString('vi-VN')} kênh`;
  if(!arr.length){
    list.innerHTML='<div class="empty"><b>Không tìm thấy kênh</b>Thử đổi từ khóa hoặc nhóm kênh.</div>';return;
  }
  list.innerHTML='';
  const frag=document.createDocumentFragment();
  arr.forEach(c=>{
    const b=document.createElement('button');
    b.className='channel'+(active===c?' active':'');
    b.innerHTML=`<img class="logo" src="${escapeHtml(c.logo||'')}" loading="lazy" onerror="this.style.visibility='hidden'">
      <div class="channel-info"><div class="channel-name">${escapeHtml(c.name)}</div><div class="channel-group">${escapeHtml(c.group||'Khác')}</div></div>
      <span class="star ${isFav(c)?'on':''}" title="Yêu thích">★</span>`;
    b.onclick=()=>play(c);
    b.querySelector('.star').onclick=e=>{e.stopPropagation();toggleFavorite(c)};
    frag.appendChild(b);
  });
  list.appendChild(frag);
}
function toggleFavorite(c){
  const key=c.name+'|'+c.url, i=favorites.indexOf(key);
  if(i>=0) favorites.splice(i,1); else favorites.push(key);
  saveFav(); render(); showToast(i>=0?'Đã bỏ khỏi yêu thích':'Đã thêm vào yêu thích');
}
function showToast(msg){
  toast.textContent=msg;toast.classList.add('show');clearTimeout(showToast.t);
  showToast.t=setTimeout(()=>toast.classList.remove('show'),1700);
}
function play(c){
  active=c;current.textContent=c.name;status.textContent='Đang kết nối tới luồng trực tiếp...';render();
  if(hls){hls.destroy();hls=null}
  video.pause();video.removeAttribute('src');video.load();
  if(window.Hls && Hls.isSupported()){
    hls=new Hls({enableWorker:true,maxBufferLength:20});
    hls.loadSource(c.url);hls.attachMedia(video);
    hls.on(Hls.Events.MANIFEST_PARSED,()=>{status.textContent='Đã tải luồng • đang phát';video.play().catch(()=>{})});
    hls.on(Hls.Events.ERROR,(e,d)=>{
      if(d.fatal){status.textContent='Không phát được luồng này — link có thể hết hạn hoặc máy chủ chặn trình duyệt.'}
    });
  }else if(video.canPlayType('application/vnd.apple.mpegurl')){
    video.src=c.url;
    video.addEventListener('loadedmetadata',()=>{status.textContent='Đã tải luồng • đang phát';video.play().catch(()=>{})},{once:true});
  }else status.textContent='Trình duyệt này không hỗ trợ HLS.';
}
search.addEventListener('input',render);
groupSelect.addEventListener('change',e=>setGroup(e.target.value));
document.querySelectorAll('.sort-btn').forEach(b=>b.onclick=()=>{
  sort=b.dataset.sort;document.querySelectorAll('.sort-btn').forEach(x=>x.classList.toggle('active',x===b));render();
});
document.getElementById('fullscreen').onclick=()=>document.querySelector('.hero').requestFullscreen?.();
document.getElementById('copy').onclick=async()=>{
  if(!active)return showToast('Chưa chọn kênh');
  try{await navigator.clipboard.writeText(active.url);showToast('Đã sao chép link stream')}catch(e){showToast('Không thể sao chép link')}
};
document.addEventListener('keydown',e=>{
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();search.focus()}
});
makeGroups();render();
</script>
